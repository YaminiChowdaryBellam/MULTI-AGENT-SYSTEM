GROQ_API_KEY=your-groq-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Optional — NCBI E-utilities asks scrapers to self-identify with a contact email
NCBI_EMAIL=

# Optional — override if the RAG-medical-system service runs somewhere other than localhost:8000
RAG_SERVICE_URL=http://localhost:8000

# Optional — free account at cloud.langfuse.com. Uncomment and fill in to enable
# tracing; left commented (not just empty — the SDK checks presence, not
# truthiness) tracing silently no-ops.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com  # or your self-hosted URL

# Optional — approximate Groq per-1M-token pricing for cost tracking; verify against
# console.groq.com/settings/billing if you need accurate (not just relative) figures.
# GROQ_COST_PER_1M_INPUT_TOKENS=0.05
# GROQ_COST_PER_1M_OUTPUT_TOKENS=0.08

# Optional — Step 6.1 model tiering. Routes routing/guard-check calls to a local
# quantized model instead of Groq. Requires `ollama serve` running with the model
# pulled (`ollama pull llama3.2:3b`); synthesis always uses Groq regardless.
# TIERED_MODELS=true
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
